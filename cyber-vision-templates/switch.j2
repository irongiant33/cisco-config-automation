hostname CVSW-{{ switch_suffix }}
no ip domain lookup
ip domain name {{ domain_name }}
vtp mode off
interface Vlan1
 no ip address
 shutdown
vlan {{ blackhole_vlan }}
 name Blackhole
vlan {{ mgmt_vlan }}
 name NETWORK_MGMT
vlan {{ cv_vlan }}
 name CYBER-VISION
 remote-span
{% for port in access_ports %}
interface {{ port }}
 switchport mode trunk
 switchport trunk allowed vlan {{ mgmt_vlan }},{{ rspan_vlan }}
 switchport trunk native vlan {{ blackhole_vlan }}
{% endfor %}
interface AppGigabitEthernet1/1
 switchport mode trunk
 no shutdown
interface Vlan{{ mgmt_vlan }}
 ip address {{ mgmt_ip }} {{ mgmt_mask }}
 no shutdown
iox
ip default-gateway {{ default_gateway }}
ip http authentication local
ip http secure-server
ip http server
monitor session 1 source vlan {{ rspan_vlan }} rx
monitor session 1 destination remote vlan {{ cv_vlan }}
monitor session 1 destination format-erspan {{ erspan_destination }}
ntp server {{ ntp_server }}
aaa new-model
aaa authentication login default local
aaa authorization exec default local if-authenticated
ip ssh version 2
line vty 0 4
 transport input ssh
line vty 5 15
 transport input ssh
license boot level network-advantage